                "equals": "Item"
            }
        },
        {
            "header": "Description *",
            "source": "description"
        },
        {
            "header": "Amount *",
            "source": "amount",
            "required": true
        },
        {
            "header": "Tax Code *",
            "source": "exportTaxCodeName",
