        },
        {
            "header": "Product/Service *",
            "source": "productServiceName",
            "required": true,
            "requiredUnless": {
                "field": "lineType",
                "equals": "Account"
            }
        },
        {
            "header": "Qty *",
            "source": "quantity",
            "required": true
