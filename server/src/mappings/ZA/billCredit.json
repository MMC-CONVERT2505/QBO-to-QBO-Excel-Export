            "required": true,
            "defaultValue": 0
        },
        {
            "header": "Class",
            "source": "className"
        },
        {
            "header": "Location",
            "source": "locationName"
        },
        {
            "header": "Terms",
            "source": "termName"
        },
        {
            "header": "Currency",
            "source": "currency"
        },
        {
            "header": "Exchange rate",
