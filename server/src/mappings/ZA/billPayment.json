{
    "entity": "billPayment",
    "region": "ZA",
    "templateSheet": "BillPayment",
    "columns": [
        {
            "header": "Ref No *",
            "source": "docNumber",
            "required": true,
            "transform": "trim"
        },
        {
            "header": "Payment Date *",
            "source": "paymentDate",
            "required": true,
            "transform": "date_ddmmyyyy"
        },
        {
            "header": "Memo",
            "source": "memo"
        },
        {
            "header": "Vendor *",
            "source": "vendorName",
            "required": true
        },
        {
            "header": "Bank or CC Account *",
            "source": "accountName",
            "required": true
        },
        {
            "header": "Amount *",
            "source": "amount",
            "required": true
        },
        {
            "header": "Bill No *",
            "source": "billNumber",
            "required": true,
            "requiredUnless": {
                "field": "transactionType",
                "equals": "JournalEntry"
            }
        },
        {
            "header": "Currency Code",
            "source": "currency"
        },
        {
            "header": "Exchange Rate",
            "source": "exchangeRate"
        },
        {
            "header": "Journal No",
            "source": "journalNumber"
        },
        {
            "header": "Transaction Type",
            "source": "transactionType",
            "required": true
        }
    ]
}